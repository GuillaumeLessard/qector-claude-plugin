{
  "mcpServers": {
    "qector-research": {
      "command": "<PYTHON_EXECUTABLE>",
      "args": [
        "<PLUGIN_ROOT>/mcp/mcp_server_secure.py",
        "--profile",
        "research"
      ],
      "env": {
        "QECTOR_SILENT": "1",
        "PYTHONUNBUFFERED": "1",
        "QECTOR_AIR_GAPPED": "1",
        "QECTOR_AUDIT_DIR": "<APPROVED_AUDIT_DIR>"
      }
    }
  }
}
