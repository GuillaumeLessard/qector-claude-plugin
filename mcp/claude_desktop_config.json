{
  "mcpServers": {
    "qector-secure": {
      "command": "<PYTHON_EXECUTABLE>",
      "args": [
        "<PLUGIN_ROOT>/mcp/mcp_server_secure.py",
        "--profile",
        "safe"
      ],
      "env": {
        "QECTOR_SILENT": "1",
        "PYTHONUNBUFFERED": "1",
        "QECTOR_AIR_GAPPED": "1",
        "QECTOR_INTEGRITY_STRICT": "1"
      }
    }
  }
}
