#!/bin/sh
# QECTOR cross-platform Python resolver (POSIX sh).
# Supported range: Python 3.9-3.13 (matches qector-decoder-v3 wheels).
# Order: $QECTOR_PYTHON -> python3 -> python. Missing or unsupported
# candidates are skipped, never fatal mid-loop; exhaustion fails closed.
set -u

supports() {
  "$1" -c 'import sys; raise SystemExit(0 if (3,9) <= sys.version_info[:2] < (3,14) else 1)' >/dev/null 2>&1
}

for candidate in \
  "${QECTOR_PYTHON:-}" \
  python3 \
  python
do
  [ -n "$candidate" ] || continue
  command -v "$candidate" >/dev/null 2>&1 || [ -x "$candidate" ] || continue
  if supports "$candidate"; then
    exec "$candidate" "$@"
  fi
done

echo "QECTOR: no Python 3.9-3.13 interpreter found." >&2
echo "qector-decoder-v3 ships wheels for Python 3.9-3.13 only;" >&2
echo "newer interpreters (3.14+) are rejected on purpose." >&2
echo "Install a supported Python (https://www.python.org/downloads/) and retry," >&2
echo "or point QECTOR_PYTHON at a supported interpreter." >&2
exit 127
