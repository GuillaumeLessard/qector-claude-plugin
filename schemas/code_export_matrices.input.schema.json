{
  "$id": "https://qector.store/schemas/mcp/2.0.0/code_export_matrices.input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "H_matrix": {
      "items": {
        "items": {
          "enum": [
            0,
            1
          ],
          "type": "integer"
        },
        "type": "array"
      },
      "type": "array"
    },
    "family": {
      "default": "rotated_surface",
      "enum": [
        "color_code",
        "heavy_hex",
        "repetition",
        "ring",
        "rotated_surface",
        "rotated_surface_corrected",
        "toric",
        "unrotated_surface",
        "custom"
      ],
      "type": "string"
    },
    "include_logicals": {
      "default": true,
      "type": "boolean"
    },
    "size": {
      "default": 5,
      "minimum": 2,
      "type": "integer"
    }
  },
  "required": [
    "family",
    "size"
  ],
  "title": "code_export_matrices",
  "type": "object"
}
