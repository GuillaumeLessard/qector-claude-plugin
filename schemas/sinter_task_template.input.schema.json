{
  "$id": "https://qector.store/schemas/mcp/2.0.0/sinter_task_template.input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decoder_name": {
      "default": "blossom",
      "enum": [
        "ambiguity_cluster",
        "auto",
        "blossom",
        "bposd",
        "cuda_batch",
        "cuda_bposd",
        "fast_union_find",
        "hybrid",
        "hybrid_cascade",
        "lookup_table",
        "native_auto",
        "opencl_batch",
        "sliding_window",
        "space_time",
        "sparse_blossom",
        "streaming",
        "two_stage",
        "union_find"
      ],
      "type": "string"
    },
    "error_rate": {
      "default": 0.05,
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "family": {
      "default": "rotated_surface",
      "enum": [
        "color_code",
        "heavy_hex",
        "repetition",
        "ring",
        "rotated_surface",
        "rotated_surface_corrected",
        "toric",
        "unrotated_surface"
      ],
      "type": "string"
    },
    "seed": {
      "default": 42,
      "minimum": 0,
      "type": "integer"
    },
    "shots": {
      "default": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "size": {
      "default": 5,
      "minimum": 2,
      "type": "integer"
    }
  },
  "required": [
    "family"
  ],
  "title": "sinter_task_template",
  "type": "object"
}
