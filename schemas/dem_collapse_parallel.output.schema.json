{
  "$id": "https://qector.store/schemas/mcp/2.0.0/dem_collapse_parallel.output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Machine-verifiable QECTOR MCP result envelope (contract 2.0).",
  "properties": {
    "artifact": {
      "additionalProperties": true,
      "type": [
        "object",
        "null"
      ]
    },
    "audit": {
      "additionalProperties": false,
      "properties": {
        "record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "record_sha256"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "claim_class": {
      "enum": [
        "runtime_verified",
        "verification_failed",
        "reference_only",
        "machine_scoped_measurement",
        "metadata_or_unverified",
        "none"
      ],
      "type": "string"
    },
    "contract_version": {
      "const": "2.0",
      "type": "string"
    },
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "UNKNOWN_TOOL",
            "RESOURCE_LIMIT",
            "LICENSE_DENIED",
            "BACKEND_UNAVAILABLE",
            "DEPENDENCY_MISSING",
            "VERIFICATION_FAILED",
            "CONTRACT_VIOLATION",
            "INTEGRITY_FAILED",
            "IO_ERROR",
            "NETWORK_DISABLED",
            "NETWORK_REQUIRED",
            "PERMISSION_DENIED",
            "PROTOCOL_ERROR",
            "RUNTIME_ERROR"
          ],
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "type",
        "message"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "mcp_sdk": {
          "type": "string"
        },
        "reference_manual": {
          "type": [
            "string",
            "null"
          ]
        },
        "server": {
          "type": "string"
        },
        "server_version": {
          "type": "string"
        }
      },
      "required": [
        "server",
        "server_version",
        "reference_manual",
        "mcp_sdk"
      ],
      "type": "object"
    },
    "result": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "collapse": {
              "additionalProperties": false,
              "properties": {
                "graphlike_edges": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "combination_rule": {
                        "type": "string"
                      },
                      "detectors": {
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 2,
                        "minItems": 1,
                        "type": "array"
                      },
                      "kind": {
                        "enum": [
                          "boundary",
                          "edge"
                        ],
                        "type": "string"
                      },
                      "members": {
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "observables": {
                              "items": {
                                "type": "string"
                              },
                              "type": "array"
                            },
                            "p": {
                              "type": "number"
                            },
                            "warnings": {
                              "items": {
                                "type": "string"
                              },
                              "type": "array"
                            }
                          },
                          "required": [
                            "p",
                            "observables"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "n_members": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "observable_rule": {
                        "enum": [
                          "most_likely",
                          "union",
                          "first"
                        ],
                        "type": "string"
                      },
                      "p_combined": {
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "type": "number"
                      },
                      "warnings": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "weight_log": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "winning_observables": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "detectors",
                      "kind",
                      "p_combined",
                      "weight_log",
                      "n_members",
                      "members",
                      "winning_observables",
                      "observable_rule",
                      "combination_rule"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "hyperedges": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "component": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "detectors": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "line": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "n_components": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "observables": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "probabilities": {
                        "items": {
                          "type": "number"
                        },
                        "type": "array"
                      },
                      "weight": {
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "line",
                      "probabilities",
                      "detectors",
                      "observables",
                      "weight"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "n_detector_free": {
                  "minimum": 0,
                  "type": "integer"
                },
                "n_graphlike_members": {
                  "minimum": 0,
                  "type": "integer"
                },
                "n_unique_edges": {
                  "minimum": 0,
                  "type": "integer"
                },
                "warnings": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "graphlike_edges",
                "hyperedges",
                "n_graphlike_members",
                "n_unique_edges",
                "n_detector_free"
              ],
              "type": "object"
            },
            "dem_text_bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "manual_worked_example_check": {
              "additionalProperties": false,
              "properties": {
                "computed_p_combined": {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                "computed_weight_log": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "expected_p_combined": {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                "expected_weight_log": {
                  "type": "number"
                },
                "matches": {
                  "type": "boolean"
                },
                "p1": {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                "p2": {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                "warnings": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "p1",
                "p2",
                "expected_p_combined",
                "computed_p_combined",
                "expected_weight_log",
                "computed_weight_log",
                "matches"
              ],
              "type": "object"
            },
            "reference_manual": {
              "pattern": "^10\\.\\d{4,9}/\\S+$",
              "type": "string"
            },
            "warnings": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "dem_text_bytes",
            "collapse",
            "manual_worked_example_check",
            "reference_manual"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Empty result carried by an error envelope.",
          "maxProperties": 0,
          "type": "object"
        }
      ]
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "elapsed_ms": {
          "minimum": 0,
          "type": "number"
        },
        "qector_decoder_v3": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "enum": [
            "local_only",
            "opt_in_pypi_freshness",
            "disabled_air_gapped",
            "package_installation_after_explicit_confirmation",
            "local_process_only"
          ],
          "type": "string"
        },
        "performance_claim": {
          "enum": [
            "none",
            "machine_scoped"
          ],
          "type": "string"
        },
        "stability": {
          "enum": [
            "stable",
            "provisional",
            "admin",
            "control"
          ],
          "type": "string"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "stability",
        "network",
        "performance_claim"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "verified",
        "reference_only",
        "measured",
        "not_checked",
        "error"
      ],
      "type": "string"
    },
    "tool": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "type": "string"
    },
    "verification": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "verified",
            "not_checked",
            "failed",
            "not_applicable",
            "reference_only"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "checks"
      ],
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "tool",
    "status",
    "claim_class",
    "provenance",
    "runtime",
    "scope",
    "verification",
    "artifact",
    "warnings",
    "result"
  ],
  "title": "QECTORToolResult<dem_collapse_parallel>",
  "type": "object"
}
