  "keywords": [
    "quantum-error-correction",
    "qec",
    "stabilizer",
    "decoding",
    "mcp"
  ],
  "mcpServers": {
    "qector-library": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/qector-python",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/mcp_server_library.py"],
      "env": {
        "QECTOR_SILENT": "1",
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}

