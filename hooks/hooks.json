{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/qector-python\" \"${CLAUDE_PLUGIN_ROOT}/scripts/qector_session_start.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__plugin_qector_qector-(library|research|admin)__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/qector-python\" \"${CLAUDE_PLUGIN_ROOT}/scripts/qector_tool_log.py\""
          }
        ]
      }
    ]
  }
}
